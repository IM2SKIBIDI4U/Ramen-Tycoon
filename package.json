{
  "name": "ramen-tycoon",
  "version": "1.0.0",
  "description": "Ramen Tycoon Web & Desktop Game",
  "main": "main.js",
  "author": "IM2SKIBIDI4U",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@clerk/clerk-js": "^5.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.ramentcoon.game",
    "productName": "Ramen Tycoon",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "main.js"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
